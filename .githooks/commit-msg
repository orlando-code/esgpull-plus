#!/usr/bin/env bash
set -euo pipefail
msg_file="${1:?commit message file required}"
tmp="$(mktemp)"
grep -Eiv \
  -e '^[[:space:]]*Co-authored-by:[[:space:]]*Cursor([[:space:]]|<|$)' \
  -e '^[[:space:]]*Co-authored-by:.*cursoragent@cursor\.com' \
  -e '^[[:space:]]*Made-with:[[:space:]]*Cursor[[:space:]]*$' \
  -e '^[[:space:]]*Made-with:[[:space:]]*Cursor[[:space:]]*<' \
  "$msg_file" > "$tmp" || true
perl -0pi -e 's/\n+\z/\n/' "$tmp"
mv "$tmp" "$msg_file"
